<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DAC9E2">

    <!-- Main Content Area inside ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="-100dp"
        android:fitsSystemWindows="false">

        <!-- Main Model Image -->
        <ImageView
            android:id="@+id/iv_main_model"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/one"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <!-- Loading Indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/pb_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/iv_main_model"
            app:layout_constraintEnd_toEndOf="@+id/iv_main_model"
            app:layout_constraintStart_toStartOf="@+id/iv_main_model"
            app:layout_constraintTop_toTopOf="@+id/iv_main_model" />

        <!-- Gradient Overlay -->
        <View
            android:id="@+id/v_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.2"
            android:background="@drawable/bg_ai_styling_gradient"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/iv_main_model"
            app:layout_constraintEnd_toEndOf="@+id/iv_main_model"
            app:layout_constraintStart_toStartOf="@+id/iv_main_model"
            app:layout_constraintTop_toTopOf="@+id/iv_main_model"
            app:layout_constraintVertical_bias="0.61" />

        <!-- No Model Message (Professional Upgrade) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_no_model_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:visibility="gone"
            app:cardBackgroundColor="#F2FFFFFF"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#1A000000"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#0D000000"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:alpha="0.8"
                        android:src="@drawable/user_2"
                        app:tint="@color/black" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="@string/ai_no_model_title"
                    android:textColor="#1E293B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/ai_no_model_desc"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_choose_model_action"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingHorizontal="24dp"
                    android:text="Select Avatar"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textStyle="bold"
                    app:backgroundTint="#F1F5F9"
                    app:cornerRadius="20dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Back Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_back_ai"
            android:layout_width="@dimen/back_button_size"
            android:layout_height="@dimen/back_button_size"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_medium"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#26FFFFFF"
            app:cardCornerRadius="50dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="@dimen/back_icon_size"
                android:layout_height="@dimen/back_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@string/back_button"
                android:src="@drawable/arrowleft"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar Section (Upgraded) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_avatar_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_medium"
            app:cardBackgroundColor="#1A000000"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back_ai"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_back_ai"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/ll_avatars"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_margin="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_add_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:alpha="0"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#40FFFFFF"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/add_avatar"
                        android:src="@drawable/plus"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Dynamic Avatars will be injected here -->

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatar_main"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="@string/add_avatar"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/user_2"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/white"
                    app:strokeWidth="2dp"
                    tools:srcCompat="@tools:sample/avatars" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right Preview Container (Upgraded) -->
        <LinearLayout
            android:id="@+id/ll_preview_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:layout_marginBottom="20dp"
            android:elevation="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Clear All Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_clear_all"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginBottom="8dp"
                android:alpha="0"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="#CC000000"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp"
                tools:alpha="1"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:rotation="45"
                        android:src="@drawable/plus"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Selected Items Counter -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_item_counter"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="-14dp"
                android:translationZ="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/white"
                app:strokeWidth="1.5dp">

                <TextView
                    android:id="@+id/tv_item_count"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="1" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Previews List Wrapper -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_preview_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#26FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_selected_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="2dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_selected_preview" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Toggle Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_toggle_preview"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#CC000000"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/iv_preview_toggle_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_up"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Sheet Card (Must be a direct child of CoordinatorLayout) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_sheet_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:behavior_peekHeight="100dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Project.BottomSheet">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_sheet_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Grabber/Handle -->
            <ImageView
                android:id="@+id/bottom_sheet_grabber"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_up"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#64748B" />

            <!-- Wardrobe Title and Filter -->

            <!-- Category Section -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_large"
                android:paddingBottom="12dp"
                app:layout_constraintTop_toBottomOf="@id/bottom_sheet_grabber">

                <TextView
                    android:id="@+id/tv_wardrobe_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="Pick Clothes"
                    android:textColor="#1E293B"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/btn_generate_collapsed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_ai_disclaimer_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AI results may vary. Check carefully."
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@+id/btn_generate_collapsed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_wardrobe_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_collapsed"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/black"
                    app:cornerRadius="24dp"
                    app:elevation="4dp"
                    app:icon="@drawable/magic"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:alpha="0"
                    android:paddingHorizontal="12dp"
                    android:text="@string/filter"
                    android:textColor="@color/ai_chip_unselected_text"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:backgroundTint="#F1F5F9"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_filter_list"
                    app:iconSize="16dp"
                    app:iconTint="@color/ai_chip_unselected_text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_large"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_header"
                tools:listitem="@layout/item_category_tab" />

            <!-- Items Container -->
            <FrameLayout
                android:id="@+id/fl_items_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"
                app:layout_constraintBottom_toTopOf="@+id/btn_generate_expanded"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rv_categories">

                <!-- Items Section -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_items"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="24dp"
                    android:paddingBottom="@dimen/spacing_small"
                    tools:listitem="@layout/item_wardrobe_card" />

                <!-- Empty State -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ll_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_empty_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/no_images_found"
                        android:textColor="#64748B"
                        android:textSize="@dimen/text_size_medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.497"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_generate_expanded"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="@dimen/spacing_large"
                android:layout_marginBottom="8dp"
                android:alpha="0"
                android:text="@string/generate_outfit_btn"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/black"
                app:cornerRadius="27dp"
                app:elevation="4dp"
                app:icon="@drawable/magic"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_small"
                app:iconTint="@color/white"
                app:layout_constraintBottom_toTopOf="@+id/tv_ai_disclaimer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_ai_disclaimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0"
                android:text="AI can make mistakes. Please check the results."
                android:textColor="#64748B"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    tools:context=".C_SignInProfilePhoto">

    <!-- Hero Background Image -->
    <ImageView
        android:id="@+id/iv_profile_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/sign_in_bg" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:fontFamily="@font/poppins"
                android:text="@string/title_add_profile_photo"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:text="@string/subtitle_profile_photo"
                android:textColor="#BBBBBB"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />

            <FrameLayout
                android:id="@+id/fl_profile_container"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_profile_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#33FFFFFF"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_placeholder_round"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/pure_color"
                    app:strokeWidth="2dp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btn_choose_photo_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="4dp"
                    app:backgroundTint="@color/pure_color"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/camera"
                    app:tint="@color/white"
                    android:contentDescription="Select profile photo" />

            </FrameLayout>

            <TextView
                android:id="@+id/tv_gender_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/poppins"
                android:text="@string/label_gender"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fl_profile_container" />

            <RadioGroup
                android:id="@+id/rg_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tv_gender_label">

                <RadioButton
                    android:id="@+id/rb_woman"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/selector_gender_bg"
                    android:button="@null"
                    android:checked="true"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:text="@string/gender_woman"
                    android:textColor="@drawable/selector_gender_text"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_man"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/selector_gender_bg"
                    android:button="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:text="@string/gender_man"
                    android:textColor="@drawable/selector_gender_text"
                    android:textSize="16sp" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_choose_photo"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/poppins"
                android:text="@string/btn_choose_gallery"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:backgroundTint="@color/chip_background_color"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/rg_gender"
                tools:layout_editor_absoluteX="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_photo"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins"
                android:text="@string/btn_save_continue"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pure_color"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/btn_choose_photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins"
                android:text="@string/btn_skip_now"
                android:textAllCaps="false"
                android:textColor="#BBBBBB"
                app:layout_constraintTop_toBottomOf="@id/btn_save_photo" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
